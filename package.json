{
  "name": "pulsechat-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Chatterly — Modern real-time communication platform built with React, TypeScript, Node.js, Socket.IO, and MongoDB",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "node server/dist/server.js",
    "start:server": "node server/dist/server.js",
    "build": "npm --prefix server run build",
    "build:all": "npm run build:server && npm run build:client",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "install:all": "npm install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"server,client\" -c \"yellow,blue\" \"npm run dev:server\" \"npm run dev:client\"",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test": "npm run test:server && npm run test:client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@google/genai": "^2.31.0"
  }
}
